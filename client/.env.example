# Copy this file to .env.local in this directory, then fill in the values below.
# Restart the Vite dev server after changing environment variables.
# For production, set these values before building; changes require a rebuild.

# Required: your Clerk application's publishable key (pk_test_... or pk_live_...).
VITE_CLERK_PUBLISHABLE_KEY=

# Optional: API base URL, including the /api path. Defaults to /api when blank.
# During development, Vite proxies /api to http://localhost:3000.
# Same-origin production hosting must route /api to the backend.
VITE_API_URL=/api

# For a separately hosted backend, use its full HTTPS API base URL instead:
# VITE_API_URL=https://api.example.com/api
# Set the server's CLIENT_URL to the frontend origin to allow CORS requests.

# Client environment values are public. Never put Clerk secret keys, database
# connection strings, JWT secrets, or other backend credentials in this file
# or in any VITE_ variable. Keep backend settings in the server environment.