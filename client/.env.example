# Copy this file to .env.local in this directory, then fill in the value below.
# Restart the Vite dev server after changing environment variables.

# Required: your Clerk application's publishable key (pk_test_... or pk_live_...).
VITE_CLERK_PUBLISHABLE_KEY=

# No API URL environment variable is currently read by the client.
# src/lib/api.ts uses /api; vite.config.ts proxies it to http://localhost:3000
# during development. Production hosting must route /api to the backend.

# Client environment values are public. Never put Clerk secret keys, database
# connection strings, JWT secrets, or other backend credentials in this file
# or in any VITE_ variable. Keep backend settings in the server environment.