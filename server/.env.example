# Local development (default)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/football_match?schema=public"

# Production (Supabase) — see docs/SUPABASE_MIGRATION.md
# For `prisma migrate deploy`, use the DIRECT connection (port 5432, db.<ref>.supabase.co).
# For the running app, use the POOLED connection (port 6543, <ref>.pooler.supabase.com).
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?schema=public"

# Clerk
CLERK_SECRET_KEY="sk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."
PORT=3000
CLIENT_URL="http://localhost:5173"

# Optional: Sentry server error monitoring DSN. Keep this server-only.
SENTRY_DSN=

# Optional: PostHog server-side analytics project token. Keep this server-only.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com